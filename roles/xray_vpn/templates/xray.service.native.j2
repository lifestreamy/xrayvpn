[Unit]
Description=Xray VPN Service (REALITY Protocol, native)
Documentation=https://xtls.github.io
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
ExecStart=/usr/local/xray/xray run -c {{ xray_config_dir }}/config.json

ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=10

# ProtectHome=read-only (not =true): =true hides /root and breaks the ReadWritePaths below.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ xray_config_dir }} {{ xray_client_configs_dir }}
PrivateTmp=true

# Enabled at deploy by the Ansible role; after a manual cp of this unit run `systemctl enable xray`.
[Install]
WantedBy=multi-user.target

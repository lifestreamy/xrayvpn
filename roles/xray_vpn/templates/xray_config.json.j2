{
  "log": {
    "loglevel": "{{ xray_log_level | default('warning') }}"
{%- if not (xray_log_access | default(false) | bool) %},
    "access": "none"
{%- endif %}
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "tag": "vless",
      "settings": {
        "clients": [
          {%- for uuid in xray_vpn_client_uuids %}
          {
            "id": "{{ uuid }}",
            "flow": "xtls-rprx-vision"
          }{{ "," if not loop.last else "" }}
          {%- endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ reality_camouflage_domain }}:443",
          "xver": 0,
          "serverNames": [
            "{{ reality_camouflage_domain }}"
          ],
          "privateKey": "{{ xray_vpn_xray_private_key }}",
          "shortIds": ["{{ xray_vpn_xray_short_id }}"]
        }
      }
    }
{% if warp_enabled | default(false) and xray_watchdog_enabled | default(true) | bool %},
    {
      "tag": "probe",
      "port": {{ xray_watchdog_probe_port | default(10820) }},
      "protocol": "socks",
      "listen": "127.0.0.1",
      "settings": {
        "auth": "noauth",
        "ip": "127.0.0.1"
      }
    }
{% endif %}
  ],
  "outbounds": [
    {% if warp_enabled | default(false) %}
    {
      "tag": "warp",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "{{ warp_parsed.secret_key }}",
        "address": [
          "{{ warp_parsed.ipv4 }}"{% if warp_ipv6 | default(false) %},
          "{{ warp_parsed.ipv6 }}"{% endif %}
        ],
        "peers": [
          {
            "publicKey": "{{ warp_parsed.peer_public_key }}",
            "endpoint": "{{ warp_endpoint }}",
            "allowedIPs": [
              "0.0.0.0/0",
              "::/0"
            ],
            "keepAlive": 25
          }
        ],
        "mtu": {{ warp_mtu }},
        "reserved": [
          {{ warp_reserved[0] | default(0) }},
          {{ warp_reserved[1] | default(0) }},
          {{ warp_reserved[2] | default(0) }}
        ],
        "domainStrategy": "{{ warp_domain_strategy | default('ForceIPv4v6') }}"
      }
    },
    {% endif %}
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ]{% if warp_enabled | default(false) and xray_watchdog_enabled | default(true) | bool %},
  "routing": {
    "rules": [
      {
        "inboundTag": ["probe"],
        "outboundTag": "warp"
      }
    ]
  }
{% endif %}
}
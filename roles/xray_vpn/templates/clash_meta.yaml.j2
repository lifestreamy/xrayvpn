# Generated by Xray VPN Ansible — Clash Verge / FlClash (Mihomo Meta)
# GitHub: [xrayvpn](https://github.com/lifestreamy/xrayvpn)
# Issue: [xrayvpn/issues/1](https://github.com/lifestreamy/xrayvpn/issues/1)
# For Amnezia client see: client_{{ item.0 }}.json

mixed-port: 7890
allow-lan: false
mode: rule
ipv6: false
log-level: info
find-process-mode: always

tun:
  enable: true
  stack: system
  auto-route: true
  auto-detect-interface: true
  dns-hijack:
    - any:53

sniffer:
  enable: true
  sniff:
    TLS:
      ports: [443, 8443]
    HTTP:
      ports: [80, 8080-8880]
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
  respect-rules: true
  default-nameserver:
    - "8.8.8.8"
    - "1.1.1.1"
  nameserver:
    - "8.8.8.8"
    - "1.1.1.1"
  proxy-server-nameserver:
    - "8.8.8.8"
    - "1.1.1.1"

proxies:
  - name: "Xray REALITY"
    type: vless
    server: "{{ ansible_host }}"
    port: "{{ xray_port | default(443) }}"
    uuid: "{{ item.1 }}"
    network: tcp
    tls: true
    udp: true
    flow: xtls-rprx-vision
    client-fingerprint: chrome
    servername: "{{ reality_camouflage_domain }}"
    reality-opts:
      public-key: "{{ xray_vpn_xray_public_key }}"
      short-id: "{{ xray_vpn_xray_short_id }}"

proxy-groups:
  - name: "Proxy"
    type: select
    proxies:
      - "Xray REALITY"

rules:
  # Pin this server DIRECT: with the tunnel up, connections to the server's
  # own address (SSH on --port, health checks) would otherwise hairpin it.
{% if ':' in ansible_host %}
  - IP-CIDR6,{{ ansible_host }}/128,DIRECT,no-resolve
{% elif ansible_host is match('^([0-9]{1,3}\.){3}[0-9]{1,3}$') %}
  - IP-CIDR,{{ ansible_host }}/32,DIRECT,no-resolve
{% else %}
  - DOMAIN,{{ ansible_host }},DIRECT
{% endif %}

  # Localhost & LAN bypass (Fix for Ollama, etc.)
  - DOMAIN-KEYWORD,localhost,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR6,::1/128,DIRECT,no-resolve

  # Ollama / model pull bypass
  - DOMAIN-SUFFIX,ollama.com,DIRECT
  - DOMAIN-SUFFIX,ollama.ai,DIRECT
  - DOMAIN-SUFFIX,cloudflarestorage.com,DIRECT

  # HuggingFace bypass
  - DOMAIN-SUFFIX,hf.co,DIRECT
  - DOMAIN-SUFFIX,huggingface.co,DIRECT

  # Steam downloads bypass
  - DOMAIN-KEYWORD,steampipe,DIRECT
  - DOMAIN-SUFFIX,steamcontent.com,DIRECT
  - DOMAIN-SUFFIX,steamserver.net,DIRECT
  - DOMAIN-SUFFIX,steamcdn-a.akamaihd.net,DIRECT
  - DOMAIN-KEYWORD,steamcontent,DIRECT

  # Desktop-oriented PROCESS-NAME example (no-op on Android)
  - PROCESS-NAME,wireshark.exe,DIRECT

  # Russian domains bypass
  - DOMAIN-SUFFIX,ru,DIRECT
  - DOMAIN-SUFFIX,xn--p1ai,DIRECT  # punycode for .рф (Mihomo-safe)
  - DOMAIN-SUFFIX,su,DIRECT

  # Final
  - MATCH,Proxy
